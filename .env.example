# ============================================================================
#  social-media-notifications — configuration
#  Copy to .env and fill in. Nothing here needs cookies or a browser session.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
PORT=3000
# Public HTTPS URL Dokploy/Traefik serves this app on. REQUIRED for instant
# push (YouTube WebSub + Facebook webhooks call back to this URL).
PUBLIC_URL=https://social-notify.example.com
DATA_DIR=/data
LOG_LEVEL=info

# --- Slack -----------------------------------------------------------------
# Slack app -> OAuth & Permissions -> Bot Token Scopes: chat:write, links:read
# Then /invite @YourBot in the target channel.
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
SLACK_CHANNEL_ID=C0C0PGXT46L
# Optional fallback if you'd rather use an Incoming Webhook than a bot token.
SLACK_WEBHOOK_URL=
# Post a "started" message on every boot (useful once, noisy forever).
SLACK_STARTUP_PING=false

# --- YouTube ---------------------------------------------------------------
YOUTUBE_ENABLED=true
# @handle, full channel URL, or a raw UC... id.
YOUTUBE_CHANNEL=@kailasasanjoseus
# Optional but strongly recommended: makes live-start detection ~20s precise
# and lets the bot tell Shorts from videos reliably.
# console.cloud.google.com -> enable "YouTube Data API v3" -> create API key.
YOUTUBE_API_KEY=
# Shared secret for the WebSub HMAC. Any random string; keep it stable.
YOUTUBE_WEBSUB_SECRET=CHANGE-ME
YOUTUBE_LIVE_POLL_SECONDS=20
YOUTUBE_LIVE_PROBE_SECONDS=30
YOUTUBE_RSS_POLL_SECONDS=60
YOUTUBE_NOTIFY_UPCOMING=true

# --- Facebook (official Graph API — needs Page admin + a free Meta app) -----
# Leave FACEBOOK_ENABLED=false until you have a Page access token.
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=CHANGE-ME
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_POLL_ENABLED=true
FACEBOOK_POLL_SECONDS=60

# --- Generic ingest --------------------------------------------------------
# Comma-separated tokens accepted by POST /ingest. Lets Make/Zapier/IFTTT (or
# any script) push an event into the same Slack pipeline.
INGEST_TOKENS=

# --- Admin -----------------------------------------------------------------
# Protects GET /status, POST /admin/test, POST /admin/resubscribe.
ADMIN_TOKEN=CHANGE-ME

# --- Dokploy (used only by scripts/dokploy.mjs, not by the running app) -----
DOKPLOY_URL=https://your-dokploy-host
DOKPLOY_API_KEY=
DOKPLOY_APP_NAME=Social-media-notifications
# Public git URL Dokploy clones from. A public repo needs no GitHub App or key.
DOKPLOY_GIT_URL=https://github.com/you/social-media-notifications.git
DOKPLOY_GIT_BRANCH=main
